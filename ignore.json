{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "files": {
    "includes": [
      "**",

      "!**/node_modules",

      "!**/dist",
      "!**/out",
      "!**/build",
      "!**/bin",
      "!**/tmp",
      "!**/temp",

      "!**/coverage",
      "!**/.nyc_output",

      "!**/.next",
      "!**/.nuxt",
      "!**/.output",
      "!**/.svelte-kit",
      "!**/.astro",
      "!**/.remix",
      "!**/.solid",
      "!**/.vinxi",
      "!**/storybook-static",

      "!**/.turbo",
      "!**/.cache",
      "!**/.angular",
      "!**/.nx",
      "!**/.parcel-cache",
      "!**/.rollup.cache",
      "!**/.wrangler",
      "!**/.serverless",
      "!**/.expo",

      "!**/.vscode",
      "!**/.idea",
      "!**/.vs",
      "!**/.fleet",
      "!**/.atom",

      "!**/.cursor",
      "!**/.windsurf",
      "!**/.claude",
      "!**/.codeium",
      "!**/.tabnine",
      "!**/.continue",
      "!**/.aider",
      "!**/.supermaven",
      "!**/.cody",

      "!**/.yarn",
      "!**/*.pnp.*",

      "!**/generated",
      "!**/__generated__",
      "!**/*.generated.ts",
      "!**/*.generated.js",
      "!**/*.generated.d.ts",
      "!**/*.min.js",
      "!**/*.min.css",
      "!**/.eslintcache",
      "!**/.stylelintcache"
    ],
    "ignoreUnknown": true
  }
}
