{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "extends": [
    "./base.json",
    "./html.json",
    "./css.json"
  ],
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "linter": {
    "rules": {
      "a11y": {},
      "nursery": {
        "useExplicitReturnType": "warn"
      }
    }
  }
}
